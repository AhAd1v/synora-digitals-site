RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Synora Digitals <onboarding@resend.dev>
RESEND_TO=synoradigitals@gmail.com
ALLOWED_ORIGIN=https://synoradigitals.com

# --- Core admin (synoradigitals.com/coreadmin) ---
# Optional — leave unset and /api/coreadmin/* returns a clean 503 instead of
# breaking the rest of the app (see config.py). Use a Neon project SEPARATE
# from any client's own database (e.g. blackbuc's) — core admin's DB must
# never live in the same database as a client's data.
# Paste Neon's connection string as-is; db.py adapts it for asyncpg automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CORE_ADMIN_JWT_SECRET=

# --- One-time seed values for scripts/init_coreadmin_db.py (not read by the app) ---
SEED_COREADMIN_EMAIL=admin@synoradigitals.com
SEED_COREADMIN_PASSWORD=change-this-before-running-the-script
